<Project>
  <Import Project="Version.props" />
  <Import Project="Development.props" Condition="Exists('Development.props')" />

  <PropertyGroup>
    <StrongNameKeyId>PulseSql.EntityFrameworkCore.MySql</StrongNameKeyId>
    <PackageTags>pulsesql;pomelo;mysql;mariadb;Entity Framework Core;entity-framework-core;ef;efcore;ef core;orm;sql</PackageTags>
    <Product>PulseSql.EntityFrameworkCore.MySql</Product>
    <Authors>Jaime Andrés Mariño Londoño; based on Pomelo by Laurents Meyer, Caleb Lloyd, Yuko Zheng</Authors>
    <Company>PulseSql</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) PulseSql contributors. Portions Copyright © Pomelo Foundation.</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PulseSql/PulseSql.EntityFrameworkCore.MySql</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/PulseSql/PulseSql.EntityFrameworkCore.MySql</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <DebugType Condition="'$(DebugType)' == ''">portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <PulseSqlTargetFramework>net10.0</PulseSqlTargetFramework>
    <PulseSqlTestTargetFramework>net10.0</PulseSqlTestTargetFramework>
    <EfCoreTargetFramework>net10.0</EfCoreTargetFramework>
    <EfCoreTestTargetFramework>net10.0</EfCoreTestTargetFramework>
    <MySqlConnectorTargetFramework>net8.0</MySqlConnectorTargetFramework>
    <MySqlConnectorDependencyInjectionTargetFramework>net8.0</MySqlConnectorDependencyInjectionTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)PulseSql.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.rd.xml" />
  </ItemGroup>
</Project>
